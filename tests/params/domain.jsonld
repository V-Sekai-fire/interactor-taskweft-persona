{
 "@context": {
  "VSEKAI": "https://v-sekai.org/",
  "domain": "VSEKAI:planning/domain/"
 },
 "@type": "domain:Definition",
 "name": "params",
 "version": "0.1.0",
 "description": "Actions and methods that take parameters. The codebook is the interned string list: a name written there is its index everywhere else, so an argument is a number or an entry of the codebook. [name] fills a pointer path, as an integer template parameter does in the glTF extension, and {\"param\": name} stands for a number in a value.",
 "variables": [
  {
   "name": "cell",
   "type": "int",
   "init": {}
  }
 ],
 "actions": {
  "mark": {
   "params": [
    "i"
   ],
   "body": [
    {
     "pointer/set": "/cell/[i]",
     "value": 1
    }
   ]
  },
  "use": {
   "params": [
    "i"
   ],
   "body": [
    {
     "eval": {
      "type": "math/ge",
      "a": {
       "type": "pointer/get",
       "pointer": "/cell/[i]"
      },
      "b": 1
     }
    },
    {
     "pointer/set": "/used/[i]",
     "value": 1
    }
   ]
  },
  "last": {
   "params": [
    "v"
   ],
   "body": [
    {
     "pointer/set": "/n/last",
     "value": {
      "param": "v"
     }
    }
   ]
  },
  "after": {
   "params": [
    "v"
   ],
   "body": [
    {
     "eval": {
      "type": "math/ge",
      "a": {
       "type": "pointer/get",
       "pointer": "/n/last"
      },
      "b": {
       "param": "v"
      }
     }
    }
   ]
  }
 },
 "methods": {
  "finish": {
   "params": [
    "i"
   ],
   "alternatives": [
    {
     "name": "go",
     "subtasks": [
      [
       "mark",
       {
        "param": "i"
       }
      ],
      [
       "use",
       {
        "param": "i"
       }
      ]
     ]
    }
   ]
  }
 },
 "codebook": [
  "a",
  "b",
  "c",
  "d",
  "e",
  "f"
 ]
}
