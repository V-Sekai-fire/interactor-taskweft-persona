{
 "@context": {
  "VSEKAI": "https://v-sekai.org/",
  "domain": "VSEKAI:planning/domain/"
 },
 "@type": "domain:Definition",
 "name": "blocks_hgn",
 "source": "GTPyhop examples/blocks_hgn",
 "version": "0.1.0",
 "description": "GTPyhop's blocks_hgn. Its unigoal methods on pos are the task pos(x,y); the multigoal method moveblocks asks for pos(x,hand) and then pos(x,destination). A block is its index in the problem's codebook. pos is a block, table (-1) or hand (-2); clear is 0 or 1; holding is a block, or nothing (-4); the goal is goal/<block>, a block, table, or free (-3).",
 "enums": {
  "place": {
   "table": -1,
   "hand": -2,
   "free": -3,
   "nothing": -4
  }
 },
 "variables": [
  {
   "name": "pos",
   "type": "int",
   "init": {}
  },
  {
   "name": "clear",
   "type": "int",
   "init": {}
  },
  {
   "name": "holding",
   "type": "int",
   "init": {}
  },
  {
   "name": "goal",
   "type": "int",
   "init": {}
  },
  {
   "name": "count",
   "type": "int",
   "init": {}
  }
 ],
 "actions": {
  "pickup": {
   "params": [
    {
     "name": "x",
     "enum": "codebook"
    }
   ],
   "body": [
    {
     "eval": {
      "type": "math/eq",
      "a": {
       "type": "pointer/get",
       "pointer": "/pos/[x]"
      },
      "b": "table"
     }
    },
    {
     "eval": {
      "type": "math/ge",
      "a": {
       "type": "pointer/get",
       "pointer": "/clear/[x]"
      },
      "b": 1
     }
    },
    {
     "eval": {
      "type": "math/eq",
      "a": {
       "type": "pointer/get",
       "pointer": "/holding/hand"
      },
      "b": "nothing"
     }
    },
    {
     "pointer/set": "/pos/[x]",
     "value": "hand"
    },
    {
     "pointer/set": "/clear/[x]",
     "value": 0
    },
    {
     "pointer/set": "/holding/hand",
     "value": {
      "param": "x"
     }
    }
   ]
  },
  "unstack": {
   "params": [
    {
     "name": "b1",
     "enum": "codebook"
    },
    {
     "name": "b2",
     "enum": "codebook"
    }
   ],
   "body": [
    {
     "eval": {
      "type": "math/eq",
      "a": {
       "type": "pointer/get",
       "pointer": "/pos/[b1]"
      },
      "b": {
       "param": "b2"
      }
     }
    },
    {
     "eval": {
      "type": "math/ge",
      "a": {
       "type": "pointer/get",
       "pointer": "/clear/[b1]"
      },
      "b": 1
     }
    },
    {
     "eval": {
      "type": "math/eq",
      "a": {
       "type": "pointer/get",
       "pointer": "/holding/hand"
      },
      "b": "nothing"
     }
    },
    {
     "pointer/set": "/pos/[b1]",
     "value": "hand"
    },
    {
     "pointer/set": "/clear/[b1]",
     "value": 0
    },
    {
     "pointer/set": "/holding/hand",
     "value": {
      "param": "b1"
     }
    },
    {
     "pointer/set": "/clear/[b2]",
     "value": 1
    }
   ]
  },
  "putdown": {
   "params": [
    {
     "name": "b1",
     "enum": "codebook"
    }
   ],
   "body": [
    {
     "eval": {
      "type": "math/eq",
      "a": {
       "type": "pointer/get",
       "pointer": "/pos/[b1]"
      },
      "b": "hand"
     }
    },
    {
     "pointer/set": "/pos/[b1]",
     "value": "table"
    },
    {
     "pointer/set": "/clear/[b1]",
     "value": 1
    },
    {
     "pointer/set": "/holding/hand",
     "value": "nothing"
    }
   ]
  },
  "stack": {
   "params": [
    {
     "name": "b1",
     "enum": "codebook"
    },
    {
     "name": "b2",
     "enum": "codebook"
    }
   ],
   "body": [
    {
     "eval": {
      "type": "math/eq",
      "a": {
       "type": "pointer/get",
       "pointer": "/pos/[b1]"
      },
      "b": "hand"
     }
    },
    {
     "eval": {
      "type": "math/ge",
      "a": {
       "type": "pointer/get",
       "pointer": "/clear/[b2]"
      },
      "b": 1
     }
    },
    {
     "pointer/set": "/pos/[b1]",
     "value": {
      "param": "b2"
     }
    },
    {
     "pointer/set": "/clear/[b1]",
     "value": 1
    },
    {
     "pointer/set": "/holding/hand",
     "value": "nothing"
    },
    {
     "pointer/set": "/clear/[b2]",
     "value": 0
    }
   ]
  }
 },
