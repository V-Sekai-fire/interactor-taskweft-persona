{
 "@context": {
  "VSEKAI": "https://v-sekai.org/",
  "domain": "VSEKAI:planning/domain/"
 },
 "@type": "domain:Definition",
 "name": "simple_hgn",
 "source": "GTPyhop examples/simple_hgn",
 "version": "0.1.0",
 "description": "GTPyhop's simple_hgn: its unigoal methods on loc are the task loc(p,y), with the same three alternatives, and GTPyhop's m_split_multigoal is the task split (two person slots). Money is in half-units: cash 20 is 40 and the taxi fare 1.5+0.5d is 3+d, so every value is an exact integer. ride_taxi and pay_driver take the fare and the cash left as arguments, computed by the method graph, because an action here only sets constants. Distances are the six pairs of GTPyhop's rigid.dist, in both directions.",
 "enums": {
  "place": {
   "table": -1,
   "hand": -2,
   "free": -3,
   "nothing": -4
  }
 },
 "variables": [
  {
   "name": "loc",
   "type": "int",
   "init": {}
  },
  {
   "name": "cash",
   "type": "int",
   "init": {}
  },
  {
   "name": "owe",
   "type": "int",
   "init": {}
  },
  {
   "name": "goal",
   "type": "int",
   "init": {}
  }
 ],
 "actions": {
  "walk": {
   "params": [
    {
     "name": "p",
     "enum": "codebook"
    },
    {
     "name": "x",
     "enum": "codebook"
    },
    {
     "name": "y",
     "enum": "codebook"
    }
   ],
   "body": [
    {
     "eval": {
      "type": "math/eq",
      "a": {
       "type": "pointer/get",
       "pointer": "/loc/[p]"
      },
      "b": {
       "param": "x"
      }
     }
    },
    {
     "pointer/set": "/loc/[p]",
     "value": {
      "param": "y"
     }
    }
   ]
  },
  "call_taxi": {
   "params": [
    {
     "name": "p",
     "enum": "codebook"
    },
    {
     "name": "x",
     "enum": "codebook"
    }
   ],
   "body": [
    {
     "pointer/set": "/loc/taxi1",
     "value": {
      "param": "x"
     }
    },
    {
     "pointer/set": "/loc/[p]",
     "value": "taxi1"
    }
   ]
  },
  "ride_taxi": {
   "params": [
    {
     "name": "p",
     "enum": "codebook"
    },
    {
     "name": "x",
     "enum": "codebook"
    },
    {
     "name": "y",
     "enum": "codebook"
    },
    "fare"
   ],
   "body": [
    {
     "eval": {
      "type": "math/eq",
      "a": {
       "type": "pointer/get",
       "pointer": "/loc/[p]"
      },
      "b": "taxi1"
     }
    },
    {
     "eval": {
      "type": "math/eq",
      "a": {
       "type": "pointer/get",
       "pointer": "/loc/taxi1"
      },
      "b": {
       "param": "x"
      }
     }
    },
    {
     "pointer/set": "/loc/taxi1",
     "value": {
      "param": "y"
     }
    },
    {
     "pointer/set": "/owe/[p]",
     "value": {
      "param": "fare"
     }
    }
   ]
  },
  "pay_driver": {
   "params": [
    {
     "name": "p",
     "enum": "codebook"
    },
    {
     "name": "y",
     "enum": "codebook"
    },
    "fare",
    "cash2"
   ],
   "body": [
    {
     "eval": {
      "type": "math/eq",
      "a": {
       "type": "pointer/get",
       "pointer": "/owe/[p]"
      },
      "b": {
       "param": "fare"
      }
     }
    },
    {
     "eval": {
      "type": "math/ge",
      "a": {
       "type": "pointer/get",
       "pointer": "/cash/[p]"
      },
      "b": {
       "param": "fare"
      }
     }
    },
    {
     "pointer/set": "/cash/[p]",
     "value": {
      "param": "cash2"
     }
    },
    {
     "pointer/set": "/owe/[p]",
     "value": 0
    },
    {
     "pointer/set": "/loc/[p]",
     "value": {
      "param": "y"
     }
    }
   ]
  }
 },
