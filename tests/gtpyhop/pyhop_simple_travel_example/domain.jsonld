{
 "@context": {
  "VSEKAI": "https://v-sekai.org/",
  "domain": "VSEKAI:planning/domain/"
 },
 "@type": "domain:Definition",
 "name": "pyhop_simple_travel_example",
 "source": "GTPyhop examples/pyhop_simple_travel_example",
 "version": "0.1.0",
 "description": "GTPyhop's copy of Pyhop's simple_travel_example: the task travel(a,x,y) with the alternatives travel_by_foot and travel_by_taxi in that order. Money is in half-units: cash 20 is 40 and the fare 1.5+0.5d is 3+d. ride_taxi and pay_driver take the fare and the cash left as arguments, computed by the method graph, because an action here only sets constants. The one distance, home to park, is dist/d.",
 "variables": [
  {
   "name": "loc",
   "type": "int",
   "init": {}
  },
  {
   "name": "cash",
   "type": "int",
   "init": {}
  },
  {
   "name": "owe",
   "type": "int",
   "init": {}
  },
  {
   "name": "dist",
   "type": "int",
   "init": {}
  }
 ],
 "actions": {
  "walk": {
   "params": [
    {
     "name": "a",
     "enum": "codebook"
    },
    {
     "name": "x",
     "enum": "codebook"
    },
    {
     "name": "y",
     "enum": "codebook"
    }
   ],
   "body": [
    {
     "eval": {
      "type": "math/eq",
      "a": {
       "type": "pointer/get",
       "pointer": "/loc/[a]"
      },
      "b": {
       "param": "x"
      }
     }
    },
    {
     "pointer/set": "/loc/[a]",
     "value": {
      "param": "y"
     }
    }
   ]
  },
  "call_taxi": {
   "params": [
    {
     "name": "a",
     "enum": "codebook"
    },
    {
     "name": "x",
     "enum": "codebook"
    }
   ],
   "body": [
    {
     "pointer/set": "/loc/taxi",
     "value": {
      "param": "x"
     }
    }
   ]
  },
  "ride_taxi": {
   "params": [
    {
     "name": "a",
     "enum": "codebook"
    },
    {
     "name": "x",
     "enum": "codebook"
    },
    {
     "name": "y",
     "enum": "codebook"
    },
    "fare"
   ],
   "body": [
    {
     "eval": {
      "type": "math/eq",
      "a": {
       "type": "pointer/get",
       "pointer": "/loc/taxi"
      },
      "b": {
       "param": "x"
      }
     }
    },
    {
     "eval": {
      "type": "math/eq",
      "a": {
       "type": "pointer/get",
       "pointer": "/loc/[a]"
      },
      "b": {
       "param": "x"
      }
     }
    },
    {
     "pointer/set": "/loc/taxi",
     "value": {
      "param": "y"
     }
    },
    {
     "pointer/set": "/loc/[a]",
     "value": {
      "param": "y"
     }
    },
    {
     "pointer/set": "/owe/[a]",
     "value": {
      "param": "fare"
     }
    }
   ]
  },
  "pay_driver": {
   "params": [
    {
     "name": "a",
     "enum": "codebook"
    },
    "fare",
    "cash2"
   ],
   "body": [
    {
     "eval": {
      "type": "math/eq",
      "a": {
       "type": "pointer/get",
       "pointer": "/owe/[a]"
      },
      "b": {
       "param": "fare"
      }
     }
    },
    {
     "eval": {
      "type": "math/ge",
      "a": {
       "type": "pointer/get",
       "pointer": "/cash/[a]"
      },
      "b": {
       "param": "fare"
      }
     }
    },
    {
     "pointer/set": "/cash/[a]",
     "value": {
      "param": "cash2"
     }
    },
    {
     "pointer/set": "/owe/[a]",
     "value": 0
    }
   ]
  }
 },
