         }
        },
        "values": {
         "0": {
          "type": 0,
          "value": [
           1
          ]
         },
         "1": {
          "node": 1,
          "socket": "index"
         }
        }
       }
      ]
     },
     "check": [
      {
       "eval": {
        "type": "math/ge",
        "a": {
         "type": "pointer/get",
         "pointer": "/graph/found"
        },
        "b": 1
       }
      }
     ],
     "subtasks": [
      [
       "mark",
       {
        "param": "at"
       }
      ]
     ]
    },
    {
