{
 "@context": {
  "VSEKAI": "https://v-sekai.org/",
  "domain": "VSEKAI:planning/domain/"
 },
 "@type": "domain:Definition",
 "name": "command_battle",
 "source": "interactor-taskweft-persona",
 "version": "0.2.0",
 "description": "A turn-based command battle. A lead and a caster act in a fixed turn order, then the foe. Attacks build a gauge; a skill spends half of it on the same turn; a full gauge allows a finisher; a spell takes a turn to cast. The page plays one round at a time: 30 rounds for a normal run, 60 for plus.",
 "variables": [
  {
   "name": "lead",
   "type": "int",
   "init": {}
  },
  {
   "name": "caster",
   "type": "int",
   "init": {}
  },
  {
   "name": "foe",
   "type": "int",
   "init": {}
  },
  {
   "name": "turn",
   "type": "int",
   "init": {}
  },
  {
   "name": "result",
   "type": "int",
   "init": {}
  }
 ],
 "actions": {
  "lead-attack": {
   "params": [
    "h",
    "g"
   ],
   "description": "The lead attacks: 45 damage, +25 gauge.",
   "body": [
    {
     "eval": {
      "type": "math/eq",
      "a": {
       "type": "pointer/get",
       "pointer": "/turn/slot"
      },
      "b": 0
     }
    },
    {
     "eval": {
      "type": "math/ge",
      "a": {
       "type": "pointer/get",
       "pointer": "/lead/hp"
      },
      "b": 1
     }
    },
    {
     "eval": {
      "type": "math/ge",
      "a": {
       "type": "pointer/get",
       "pointer": "/foe/hp"
      },
      "b": 1
