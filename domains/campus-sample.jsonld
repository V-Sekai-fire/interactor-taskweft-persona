{
 "@context": {
  "VSEKAI": "https://v-sekai.org/",
  "domain": "VSEKAI:planning/domain/"
 },
 "@type": "domain:Definition",
 "name": "campus_sample",
 "source": "interactor-taskweft-persona",
 "version": "0.1.0",
 "description": "Skills and tokens: settle-N holds when the skills it needs are settled and the tokens it spends are acquired, and acquire-token-T takes a token. Variables are declared here and given their values by a problem.",
 "variables": [
  {
   "name": "rfd",
   "type": "int",
   "description": "1 when an RFD is settled.",
   "init": {}
  },
  {
   "name": "token",
   "type": "int",
   "description": "1 when a token is acquired.",
   "init": {}
  }
 ],
 "actions": {
  "acquire-token-3": {
   "params": [],
   "body": [
    {
     "pointer/set": "/token/3",
     "value": 1
    }
   ]
  },
  "acquire-token-B1": {
   "params": [],
   "body": [
    {
     "pointer/set": "/token/B1",
     "value": 1
    }
   ]
  },
  "settle-2": {
   "params": [],
   "body": [
    {
     "eval": {
      "type": "pointer/ge",
      "pointer": "/rfd/1",
      "value": 1
     }
    },
    {
     "eval": {
      "type": "pointer/ge",
      "pointer": "/token/3",
      "value": 1
     }
    },
    {
     "pointer/set": "/rfd/2",
     "value": 1
    }
   ],
   "duration": "P2D"
  },
  "settle-3": {
   "params": [],
   "body": [
    {
     "eval": {
      "type": "pointer/ge",
      "pointer": "/rfd/2",
      "value": 1
     }
    },
    {
     "eval": {
      "type": "pointer/ge",
      "pointer": "/token/B1",
      "value": 1
     }
    },
    {
     "pointer/set": "/rfd/3",
     "value": 1
    }
   ],
   "duration": "P3D"
  }
 },
 "methods": {
  "/token/3": {
   "alternatives": [
    {
     "name": "acquire",
     "subtasks": [
      [
       "acquire-token-3"
      ]
     ]
    }
   ]
  },
  "/token/B1": {
   "alternatives": [
    {
     "name": "acquire",
     "subtasks": [
      [
       "acquire-token-B1"
      ]
     ]
    }
   ]
  },
  "/rfd/2": {
   "alternatives": [
    {
     "name": "settle",
     "subtasks": [
      [
       "goal",
       "/rfd/1"
      ],
      [
       "goal",
       "/token/3"
      ],
      [
       "settle-2"
      ]
     ]
    }
   ]
  },
  "/rfd/3": {
   "alternatives": [
    {
     "name": "settle",
     "subtasks": [
      [
       "goal",
       "/rfd/2"
      ],
      [
       "goal",
       "/token/B1"
      ],
      [
       "settle-3"
      ]
     ]
    }
   ]
  }
 }
}
