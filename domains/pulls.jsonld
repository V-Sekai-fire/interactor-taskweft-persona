{
  "@context": {
    "khr": "https://registry.khronos.org/glTF/extensions/2.0/KHR_interactivity/",
    "domain": "khr:planning/domain/"
  },
  "@type": "domain:Problem",
  "name": "persona_pulls",
  "source": "interactor-taskweft-persona",
  "version": "0.1.0",
  "description": "How a pull request reaches main in this repository: a stage-named branch, a push, a body with no agent credit, the pull, the two checks, then the merge. The merge asks the graph for operator--approves--pull, and no action writes that edge.",
  "variables": [
    {
      "name": "pull",
      "type": "int",
      "description": "Facts about one pull request; 1 holds, 0 does not.",
      "init": {
        "staged": 0, "pushed": 0, "clean": 0, "open": 0,
        "lean": 0, "elf": 0, "checked": 0, "merged": 0
      }
    }
  ],
  "capabilities": {
    "entities": { "operator": ["human"], "pull": ["pull-request"] },
    "graph": { "edges": [] }
  },
  "actions": {
    "name-branch-by-stage": { "params": [], "body": [{ "pointer/set": "/pull/staged", "value": 1 }] },
    "push-branch": { "params": [], "body": [{ "pointer/set": "/pull/pushed", "value": 1 }] },
    "strip-agent-footer": { "params": [], "body": [{ "pointer/set": "/pull/clean", "value": 1 }] },
    "open-pull": { "params": [], "body": [{ "pointer/set": "/pull/open", "value": 1 }] },
    "run-lean-check": { "params": [], "body": [{ "pointer/set": "/pull/lean", "value": 1 }] },
    "run-elf-check": { "params": [], "body": [{ "pointer/set": "/pull/elf", "value": 1 }] },
    "collect-checks": { "params": [], "body": [{ "pointer/set": "/pull/checked", "value": 1 }] },
    "merge-pull": {
      "params": [],
      "body": [
        { "eval": { "type": "rebac/check", "subject": "operator", "rel": "approves", "object": "pull" } },
        { "pointer/set": "/pull/merged", "value": 1 }
      ]
    }
  },
  "methods": {
    "/pull/open": {
      "alternatives": [{
        "name": "stage_push_clean_open",
        "subtasks": [["name-branch-by-stage"], ["push-branch"], ["strip-agent-footer"], ["open-pull"]]
      }]
    },
    "/pull/checked": {
      "alternatives": [{
        "name": "open_then_both_checks",
        "subtasks": [["goal", "/pull/open"], ["run-lean-check"], ["run-elf-check"], ["collect-checks"]]
      }]
    },
    "/pull/merged": {
      "alternatives": [{
        "name": "checked_then_merge",
        "subtasks": [["goal", "/pull/checked"], ["merge-pull"]]
      }]
    }
  },
  "todo_list": [{ "goal": [{ "pointer": "/pull/merged", "eq": 1 }] }]
}
